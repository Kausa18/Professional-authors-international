# Settings for the Professional Authors Zambia website.
# Copy this file to .env and fill in your own values. Never share or commit .env.
# On a hosting service (Render, Railway, ...), enter these in its
# "Environment variables" settings instead of uploading this file.

# ---------- Required ----------

# Password for the Admin page (/admin). Use a long, random one.
# If left empty while developing, a temporary password is printed at start-up.
ADMIN_PASSWORD=choose-a-long-password

# PostgreSQL connection string.
#   Your own server:  run "npm run db:create" and it is filled in for you.
#   Neon/Supabase:    paste the string they give you; keep "?sslmode=require" on the end.
#   Format:           postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Leave empty while developing to use the built-in local database (.data/pglite).
# Required in production.
DATABASE_URL=

# ---------- Server ----------

# "development" on your computer, "production" on the live site.
# Production turns on secure cookies and strict security headers, and requires
# ADMIN_PASSWORD and DATABASE_URL to be set.
NODE_ENV=development

# Port the website listens on. Most hosts set this for you.
PORT=3000

# How many proxies sit in front of the site, so login limits apply per visitor.
# Empty means: 1 in production (right for Render, Railway, nginx), none in development.
# Set 0 only if visitors connect to Node directly with no proxy in between.
TRUST_PROXY=

# ---------- Vercel deployment only ----------

# Actual HTTPS origin of the Render service, without a path.
# Set this in Vercel's Environment Variables before deploying.
# Used by npm run build:vercel to forward pages and API requests to Render.
# DATABASE_URL and ADMIN_PASSWORD belong on Render only.
RENDER_ORIGIN=
