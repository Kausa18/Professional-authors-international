# Copy this file to .env and fill in your own values. Never share or commit .env.

# Password for the Admin page (/admin). Use a long one.
ADMIN_PASSWORD=choose-a-long-password

# PostgreSQL connection string, e.g. from Neon or Supabase, or your own server:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Leave it out while developing to use the built-in local database (.data/pglite).
DATABASE_URL=

# Optional
# PORT=3000
# How many proxies sit in front of the site (production default: 1, right for Render and Railway).
# TRUST_PROXY=1
